# Domaine dédié au moteur PDF (sous-domaine distinct de l'application LTPC)
GOTENBERG_DOMAIN=pdf.ltpc.dz

# Secret d'appel partagé entre le backend LTPC et le proxy Caddy.
# Générer avec :  openssl rand -hex 32
# La MÊME valeur doit être enregistrée côté LTPC dans le secret GOTENBERG_SHARED_SECRET.
GOTENBERG_SHARED_SECRET=
